{
  "name": "notes2flow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "extract": "tsx src/extract.ts",
    "review": "tsx src/review-cli.ts",
    "eval": "tsx src/eval.ts",
    "server": "tsx src/server.ts",
    "dev": "concurrently \"npm run server\" \"vite\"",
    "build": "vite build"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^3.2.0"
  }
}
